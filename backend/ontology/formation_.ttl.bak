### Classe définie : un Boursier est un Apprenant qui bénéficie d'au moins une Bourse
:Boursier rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:intersectionOf ( :Apprenant
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :beneficieDeBourse ;
                                                       owl:someValuesFrom :Bourse
                                                     ] )
                              ] ;
          rdfs:subClassOf :Apprenant ;
          rdfs:label "Boursier"@fr .

### Restriction de cardinalité : un Stage est accueilli par au plus une organisation
:Stage rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :accueilliPar ;
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                       ] .
